# Port d'écoute du serveur
PORT=3001

# Origine du frontend autorisée (l'URL où tourne ton index.html une fois hébergé)
# En local pendant les tests, tu peux mettre "*" temporairement.
FRONTEND_URL=http://localhost:5500

# Secret utilisé pour signer les tokens de connexion (JWT). Mets une longue chaîne aléatoire.
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Clé API Steam (gratuite) : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Clé API Anthropic (pour que SOS réponde avec une vraie IA) : https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle Claude à utiliser pour SOS
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Abonnement (Stripe) ---
# Clé secrète Stripe : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ID du prix récurrent de ton abonnement GameFit Premium (créé dans
# Stripe → Produits → ajoute un produit avec un prix récurrent mensuel,
# copie son "Price ID", commence par price_...)
STRIPE_PRICE_ID=

# Secret de vérification du webhook Stripe (créé quand tu configures
# le endpoint webhook dans Stripe → Developers → Webhooks) :
# pointe-le vers https://TON_BACKEND/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

